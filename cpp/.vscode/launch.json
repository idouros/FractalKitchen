{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug fkcl",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/x64-debug/fkcl/fkcl.exe",
      "args": ["${workspaceFolder}/configs/mandelbrot01.config"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Release fkcl",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/x64-release/fkcl/fkcl.exe",
      "args": ["${workspaceFolder}/configs/mandelbrot01.config"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    }
  ]
}