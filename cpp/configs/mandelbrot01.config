[fractal]
type = Mandelbrot
max_iter = 500
divergence_threshold = 5.5
xtra_1_label = z_real
xtra_2_label = z_imag

[image]
n_cols = 640
n_rows = 480
x_start = -2.5
x_end = 1.5
y_start = -1.5
colour_mode = DISTANCE_CONTOURS
colour_cycles = 0.8
histogram_smoothing = true
output_dir = /fractals

[device]
platformId = 0
deviceId = 0
showDeviceList = false
